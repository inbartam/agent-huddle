{
  "name": "@huddle/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Agent Huddle desktop app: Electron main (hosts core), sandboxed preload, React renderer",
  "author": "Agent Huddle contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inbartam/agent-huddle.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://github.com/inbartam/agent-huddle#readme",
  "bugs": {
    "url": "https://github.com/inbartam/agent-huddle/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs resources/tray.ico",
    "icon:app": "node scripts/make-icon.mjs resources/icon.ico --app",
    "package": "electron-vite build && electron-builder --win --config electron-builder.json --publish never"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huddle/core": "*",
    "@huddle/shared": "*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
